# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT THE .env FILE - It contains sensitive credentials

# Main Database Configuration (coop_admin)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# Secondary Database Configuration (info database - optional)
DB_INFO_HOST=localhost
DB_INFO_NAME=your_info_database_name
DB_INFO_USER=your_info_username
DB_INFO_PASSWORD=your_info_password

# Auth API Database Configuration (optional - uses main DB if not set)
DB_AUTH_HOST=localhost
DB_AUTH_NAME=your_auth_database_name
DB_AUTH_USER=your_auth_username
DB_AUTH_PASSWORD=your_auth_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=3600

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Email Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_email
SMTP_PASSWORD=your_email_password

# Security
ENCRYPTION_KEY=your_encryption_key

# Application
APP_NAME="Cooperative Management System"
APP_URL=https://www.emmaggi.com/coop_admin
APP_ENV=production

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OpenAI API (if used)
OPENAI_API_KEY=your_openai_api_key_here

# API Secret
API_SECRET=your_api_secret
